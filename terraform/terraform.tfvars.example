# Copy this file to terraform.tfvars and fill in your own values.
# The real terraform.tfvars is listed in .gitignore and must not be committed.

# Get it with: az account show --query id -o tsv
subscription_id = "00000000-0000-0000-0000-000000000000"

# Get your public IP with: curl -4 -s ifconfig.me
ssh_allowed_cidrs = ["203.0.113.10/32"]

# Get it with: cat ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Must be unique within the region.
# Becomes weather-station.mexicocentral.cloudapp.azure.com
dns_label = "weather-station"

# Must be globally unique. Lowercase letters and digits only, no hyphens.
# Check availability with: az acr check-name --name weatherstationacr
acr_name = "weatherstationacr"

# GitHub organization or user that owns the application repositories.
github_owner = "your-org"

# The immutable OIDC subject carries these numeric IDs, not the names.
# Get them with: curl -s https://api.github.com/orgs/<owner> | jq .id
github_owner_id = "000000000"
# Get them with: curl -s https://api.github.com/repos/<owner>/<repo> | jq .id
github_backend_repo_id  = "000000000"
github_frontend_repo_id = "000000000"
